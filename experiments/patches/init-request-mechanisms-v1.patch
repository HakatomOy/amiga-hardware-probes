+    pub(crate) fn start_cpu_jump_tail(&mut self, second_list: bool, vpos: u32, hpos: u32) {
+        let reuse = crate::bus::exp_startup_request_mode() & 2 != 0
+            && matches!(
+                self.state,
+                CopperState::Waiting {
+                    phase: CopperWaitPhase::InstructionTail,
+                    ..
+                }
+            );
+        if crate::envcfg::flag("COPPERLINE_DIAG_COP_STROBES") {
+            eprintln!(
+                "COPSTROBE v={vpos:03x} h={hpos:02x} state={:?} pending={:?} reuse={reuse}",
+                self.state, self.pending_first
+            );
+        }
+        self.start_jump_tail(second_list);
+        if reuse {
+            self.state = CopperState::Jumping {
+                second_list,
+                phase: CopperJumpPhase::Second,
+            };
+        }
+    }
