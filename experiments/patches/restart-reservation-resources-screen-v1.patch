+    assert!(bus.copper.restart_needs_bus());
+    bus.agnus.hpos = 0x42;
+    let before = bus.emulated_cck;
+    bus.grant_cpu_bus_access_at(Some(0x12000), 2, CpuBusAccessKind::Write);
+    assert_eq!(bus.emulated_cck - before, 3);
+    assert_eq!(bus.copper.pc(), 0x1002);
+    assert!(bus.copper.mid_instruction());
+}
