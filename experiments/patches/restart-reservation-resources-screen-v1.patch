+    pub(super) fn sample_cpu_copper_dma_gate(&mut self, value: u16) {
+        let enabled_before = self.copper_dma_enabled();
+        let copen_before = self.agnus.dmacon & crate::chipset::copper::DMACON_COPEN != 0;
+        self.agnus.write_dmacon(value & 0x8080);
