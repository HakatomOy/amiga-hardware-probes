+#[test]
+fn uncontended_cpu_writes_preserve_init_overlap() {
+    for priority in [0, DMACON_BLTPRI] {
+        for (kind, next) in [
+            (CpuBusAccessKind::Read, "D"),
+            (CpuBusAccessKind::Write, "D"),
