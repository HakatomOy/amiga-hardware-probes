+#[test]
+fn cpu_copjmp_transfer_starts_before_the_bus_tail() {
+    for (read, grant) in [(false, 0x40), (true, 0x40), (false, 0x41), (true, 0x41)] {
+        let mut bus = empty_bus();
+        bus.set_cpu_bus_arbitration_enabled(true);
