+#[test]
+fn cpu_blitter_init_waits_for_copper_but_start_delay_can_overlap_it() {
+    let mut bus = empty_bus();
+    bus.agnus.dmacon = DMACON_DMAEN | DMACON_COPEN | DMACON_BLTEN;
+    bus.copper.jump(0x1000);
+    bus.blitter.bltcon0 = 0x09f0;
+    bus.blitter.start_scheduled(0x41, &bus.mem.chip_ram);
+    bus.agnus.hpos = 0x40;
+    bus.advance_chipset(1); // Copper overlaps the start delay.
+    assert_eq!(bus.blitter.current_slot_label(), "INIT");
+    bus.agnus.hpos = 0x42; // Another Copper fetch cannot consume Init.
+    bus.advance_chipset(1);
+    assert_eq!(bus.blitter.current_slot_label(), "INIT");
+    bus.advance_chipset(1); // Free clock permits Init, without fetching A yet.
+    assert_eq!(bus.blitter.current_slot_label(), "A");
+}
