+            let line_cck = self.agnus.current_line_cck();
+            while ((self.agnus.hpos + distance) % line_cck) & 1 == 0 {
+                distance += 1;
+            }
+            self.copper_enable_ready_at = self.emulated_cck.saturating_add(u64::from(distance));
+            self.copper_active_in_frame = true;
+        }
     }
 
