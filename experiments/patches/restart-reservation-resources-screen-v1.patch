+        bus.agnus.cop1lc = 0x1000;
+        write_chip_word(&mut bus, 0x1000, 0x0180);
+        write_chip_word(&mut bus, 0x1002, 0x0123);
+        write_chip_word(&mut bus, 0x1004, 0xffff);
+        write_chip_word(&mut bus, 0x1006, 0xfffe);
+        bus.agnus.hpos = grant;
+        if read {
+            bus.custom_read(0x088, 2);
+        } else {
+            bus.custom_write(0x088, 2, 0);
+        }
+        while bus.agnus.hpos < 0x48 {
+            bus.advance_chipset(1);
+        }
+        assert_eq!(bus.denise.palette[0], 0);
+        bus.advance_chipset(1);
+        assert_eq!(bus.denise.palette[0], 0x0123, "read={read}");
+    }
