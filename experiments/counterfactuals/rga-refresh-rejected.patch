+
+#[test]
+fn stock_cpu_turnaround_checks_upcoming_copper_refresh_even_after_idle_lockout() {
+    for kind in [CpuBusAccessKind::Read, CpuBusAccessKind::Write, CpuBusAccessKind::Custom] {
+        let mut bus = empty_bus();
+        bus.set_cpu_bus_arbitration_enabled(true);
+        bus.agnus.dmacon = DMACON_DMAEN | DMACON_COPEN;
+        bus.copper.jump(0x1000);
+        bus.agnus.hpos = 0x0e1;
+        bus.last_chip_bus_owner = ChipBusOwner::Idle;
+        assert!(bus.cpu_cycle_crosses_line_end_refresh());
+        bus.grant_cpu_bus_access(2, kind);
+        assert!(bus.take_slice_bus_advance().0 > 2);
     }
+    let mut quiet = empty_bus();
+    quiet.agnus.hpos = 0x0e1;
+    assert!(!quiet.cpu_cycle_crosses_line_end_refresh());
 }
 
