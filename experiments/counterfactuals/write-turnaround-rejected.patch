diff --git a/src/bus/dma_slots.rs b/src/bus/dma_slots.rs
index 12cfe99a..ad1bb9f5 100644
--- a/src/bus/dma_slots.rs
+++ b/src/bus/dma_slots.rs
@@ -812,9 +812,10 @@ impl Bus {
     }
 
     pub(super) fn cpu_cycle_crosses_line_end_refresh(&self) -> bool {
-        // Kind65 and trace controls isolate DRAM read turnaround after a
-        // Copper transfer immediately before refresh. Uncontended reads,
-        // writes and register grants retain their existing phase.
+        // DRAM transfers need turnaround after a Copper transfer immediately
+        // before refresh. This includes writes: kind78/80/81 hardware races
+        // expose the launch witness's RAM writeback and CPU/Copper ordering.
+        // Uncontended transfers and custom-register grants keep their phase.
         !self.cpu_short_bus_cycle
             && !self.aga_enabled()
             && self.last_chip_bus_owner == ChipBusOwner::Copper
