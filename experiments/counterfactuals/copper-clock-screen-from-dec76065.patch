+#[test]
+fn cpu_copen_transfer_exposes_the_same_restart_phase_at_neighboring_grants() {
+    for grant in [0x40, 0x41] {
+        let mut bus = empty_bus();
+        bus.set_cpu_bus_arbitration_enabled(true);
+        bus.agnus.dmacon = DMACON_DMAEN;
+        bus.agnus.cop1lc = 0x1000;
+        write_chip_word(&mut bus, 0x1000, 0x009c);
+        write_chip_word(&mut bus, 0x1002, 0x8004);
+        bus.copper.start_jump_tail(false);
+        bus.agnus.hpos = grant;
+        bus.custom_write(0x096, 2, 0x8080);
+        while bus.agnus.hpos < 0x47 {
+            bus.advance_chipset(1);
+        }
+        assert_eq!(bus.copper.pc(), 0x1002, "grant {grant:x}");
+        assert!(bus.copper.mid_instruction());
+        assert_eq!(bus.paula.intreq & INT_SOFT, 0);
+    }
+}
+
+#[test]
