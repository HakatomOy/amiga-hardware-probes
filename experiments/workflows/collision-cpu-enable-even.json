{
  "version": 1,
  "id": "collision-cpu-enable-even",
  "hypothesis": "Classic BMAPEN assertion is sampled on the even CCK of the fetch-counter step; odd-clock assertion currently starts a partial unit one CCK too early.",
  "competitor": "The observed drift is caused by CPU custom-read sampling rather than the bitplane enable phase.",
  "test": "Round only classic DDF BMAPEN_SET effects to the next even CCK. Require all256 stable first-divergence controls and512 original collision cases; retain immediate/register control instability, gated and bus/CIA neighbors without aligning traces.",
  "outcomes": {
    "repairs all stable phases without neighbors changing": "Accept the narrowly measured enable sampling correction.",
    "neighbors regress or first poll still differs": "Reject and isolate the first enable/fetch boundary with a new probe."
  },
  "next_question": "Does even-step BMAPEN sampling repair the original24 cases without regressions?",
  "investigation": "investigations/collision-cpu-enable-even.json",
  "binary": "../Copperline/target/ci/copperline.exe",
  "romdir": "build/collision-cpu-poll-v1",
  "config": "../Copperline/tmp/golden-a500-ecs.toml",
  "rom_sha256": "93bf458780470749afcdfa725018ca14deb341ca63456fb15f714ce52645d4ec",
