irq_stage_trial:
        movem.l d0-d7/a0-a3,-(sp)
        move.l #$ffd900,$64
        move.l #$ffd940,$68
        move.l #$ffd980,$6c
        move.l #$ffd9c0,$78
        clr.w EVCOUNT(a5)
        clr.w EVLEVEL(a5)
        clr.w EVBEAM(a5)
        clr.l EVPC(a5)
        clr.w 20(a5)
        clr.w 22(a5)
        clr.w 26(a5)
        move.w #$7fff,$96(a6)
        move.w #$7fff,$9a(a6)
        move.w #$7fff,$9c(a6)
        move.b #$7f,$bfed01
        move.b #$7f,$bfdd00
        clr.b $bfee01
        clr.b $bfde00
        tst.b $bfed01
        tst.b $bfdd00
        move.w 8(a4),d0
        addi.w #32,d0
        move.b d0,$bfe401
        clr.b $bfe501
        move.b d0,$bfd400
        clr.b $bfd500
        move.w 4(a4),d0
        add.w d0,d0
        lea .masks(pc),a0
        move.w 0(a0,d0.w),d5
        move.w d5,18(a5)
        move.l #$6000,a0
        move.w 8(a4),d0
        add.w d0,d0
        addi.w #$4261,d0
        move.w d0,(a0)+
        move.w #$fffe,(a0)+
        move.w #$009c,(a0)+
        move.w d5,d0
        cmpi.w #0,4(a4)
        beq.s .no_copper_source
        cmpi.w #2,4(a4)
        beq.s .no_copper_source
        ori.w #$8000,d0
        bra.s .list_source
.no_copper_source:
        clr.w d0
.list_source:
        move.w d0,(a0)+
        move.w #$4661,(a0)+
        move.w #$fffe,(a0)+
        move.w #$009c,(a0)+
        move.w #$8004,(a0)+
        move.l #$fffffffe,(a0)
        move.l #$6000,$80(a6)
        lea $18100,a1
        move.w 6(a4),d3
        clr.w 6(a4)
        jsr sync_beam
        move.w d3,6(a4)
        jsr $ffca00
        move.w #$2700,sr
        move.w 6(a6),16(a4)
        move.w $1e(a6),18(a4)
        cmpi.w #4,2(a4)
        beq.s .masked_done
        move.w 26(a5),18(a4)
        move.w 20(a5),20(a4)
        move.w 22(a5),22(a4)
        move.w EVBEAM(a5),24(a4)
        move.w EVLEVEL(a5),26(a4)
        move.l EVPC(a5),28(a4)
        move.w EVCOUNT(a5),34(a4)
        move.w d1,36(a4)
        move.w a1,38(a4)
        move.w #1,32(a4)
        cmpi.w #1,EVCOUNT(a5)
        bne.s .cleanup
        cmpi.w #1,EVLEVEL(a5)
        beq.s .cleanup
        clr.w 32(a4)
        bra.s .cleanup
.masked_done:
        clr.w 32(a4)
.cleanup:
        move.w #$7fff,$9a(a6)
        move.w #$7fff,$96(a6)
        move.w #$7fff,$9c(a6)
        move.b #$7f,$bfed01
        move.b #$7f,$bfdd00
        tst.b $bfed01
        tst.b $bfdd00
        move.l #irq2,$68
        move.l #irq3,$6c
        move.l #irq6,$78
        movem.l (sp)+,d0-d7/a0-a3
        rts
.masks: dc.w $0008,$0010,$2000,$0008,$2000
